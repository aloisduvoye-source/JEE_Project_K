<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Nom de l'unité de persistance (à utiliser dans votre code Java avec JpaUtil) -->
    <persistence-unit name="AssurancePU" transaction-type="RESOURCE_LOCAL">
        <!-- Déclaration d'Hibernate comme fournisseur JPA -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entités gérées par Hibernate (ajouter ici chaque nouvelle classe @Entity) -->
        <class>fr.cytech.assurance.model.Utilisateur</class>
        <class>fr.cytech.assurance.model.Client</class>
        <class>fr.cytech.assurance.model.TypeAssurance</class>
        <class>fr.cytech.assurance.model.Contrat</class>
        <class>fr.cytech.assurance.model.Garantie</class>
        <class>fr.cytech.assurance.model.Sinistre</class>
        <class>fr.cytech.assurance.model.PieceJustificative</class>
        <class>fr.cytech.assurance.model.CommentaireSinistre</class>
        <class>fr.cytech.assurance.model.Paiement</class>
        <class>fr.cytech.assurance.model.MessageAssistant</class>

        <properties>
            <!-- Driver JDBC pour MySQL. L'URL, l'utilisateur et le mot de passe viennent des variables
                 DB_URL, DB_USER et DB_PASSWORD (fichier .env ou docker-compose.yml), lues par JpaUtil -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!--
              Les tables sont créées par database/schema.sql (et remplies par dump.sql).
              'validate' vérifie au démarrage que les entités correspondent aux tables, sans rien modifier.
              Ne pas mettre 'create' : cela effacerait la base à chaque lancement.
            -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Afficher les requêtes SQL dans la console pour déboguer -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
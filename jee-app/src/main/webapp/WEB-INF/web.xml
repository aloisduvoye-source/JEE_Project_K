<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Assurance</display-name>

    <!-- Les servlets sont déclarées avec l'annotation @WebServlet dans le package controller -->

    <!-- Montants affichés en français (1 250,00 €) quelle que soit la langue du navigateur :
         utilisé par <fmt:formatNumber>, donc par le tag <app:euros> (WEB-INF/tags/euros.tag) -->
    <context-param>
        <param-name>jakarta.servlet.jsp.jstl.fmt.locale</param-name>
        <param-value>fr_FR</param-value>
    </context-param>

    <!-- Les JSP et les fragments inclus (.jspf, comme l'en-tête) sont en UTF-8 -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <!-- Page affichée quand un utilisateur ouvre une page réservée à un autre rôle (RoleFiltre) -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/common/acces-refuse.jsp</location>
    </error-page>

</web-app>

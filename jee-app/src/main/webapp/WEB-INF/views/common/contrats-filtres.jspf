<%--
  Listes déroulantes du filtre des contrats, communes à la liste de l'agent et à celle du client.
  À inclure dans un <form method="get" class="barre-outils">, avant le bouton d'envoi.
  Attend les attributs "statuts", "statutChoisi", "types" et "typeChoisi".
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<label>
  <span class="visuellement-cache">Statut</span>
  <select class="saisie" name="statut">
    <option value="">Tous les statuts</option>
    <c:forEach var="st" items="${statuts}">
      <option value="${st}" ${st == statutChoisi ? 'selected' : ''}>
        <c:choose>
          <c:when test="${st == 'EN_ATTENTE'}">En attente</c:when>
          <c:when test="${st == 'ACTIF'}">Actifs</c:when>
          <c:when test="${st == 'SUSPENDU'}">Suspendus</c:when>
          <c:when test="${st == 'EXPIRE'}">Expirés</c:when>
          <c:when test="${st == 'RESILIE'}">Résiliés</c:when>
          <c:otherwise><c:out value="${st}"/></c:otherwise>
        </c:choose>
      </option>
    </c:forEach>
  </select>
</label>
<label>
  <span class="visuellement-cache">Type d'assurance</span>
  <select class="saisie" name="type">
    <option value="">Tous les types</option>
    <c:forEach var="t" items="${types}">
      <option value="${t.id}" ${t.id == typeChoisi ? 'selected' : ''}><c:out value="${t.nom}"/></option>
    </c:forEach>
  </select>
</label>

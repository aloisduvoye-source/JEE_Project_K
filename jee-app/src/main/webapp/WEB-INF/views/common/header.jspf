<%--
  En-tête commun à toutes les pages. À inclure juste après <body> :
    <%@ include file="/WEB-INF/views/common/header.jspf" %>
  "Mon compte", "Mon espace" et "Se déconnecter" ne sont affichés qu'à un utilisateur connecté.
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header>
  <nav>
    <a href="${pageContext.request.contextPath}/">Accueil</a>
    <c:if test="${not empty sessionScope.utilisateur}">
      | <a href="${pageContext.request.contextPath}/compte">Mon compte</a>
      | <a href="${pageContext.request.contextPath}${sessionScope.utilisateur.role.accueil}">Mon espace</a>
      <%-- Formulaire en POST : DeconnexionServlet ne déconnecte pas sur un simple lien (GET) --%>
      | <form method="post" action="${pageContext.request.contextPath}/deconnexion" style="display: inline">
          <button type="submit">Se déconnecter</button>
        </form>
    </c:if>
    <c:if test="${empty sessionScope.utilisateur}">
      | <a href="${pageContext.request.contextPath}/connexion">Se connecter</a>
    </c:if>
  </nav>

  <c:if test="${not empty sessionScope.utilisateur}">
    <p>
      Bonjour <c:out value="${sessionScope.utilisateur.prenom} ${sessionScope.utilisateur.nom}"/>
      (<c:out value="${sessionScope.utilisateur.role}"/>)
    </p>
  </c:if>
</header>
<hr>

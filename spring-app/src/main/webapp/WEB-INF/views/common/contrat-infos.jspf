<%@ page pageEncoding="UTF-8" %>
<%--
  Informations d'un contrat, communes à la fiche de l'agent et à celle du client :
  client, type, dates, prime, statut, garanties et état du paiement (sans formulaire).
  Attend les attributs "contrat" (avec client, type et garanties chargés) et "paiement" (peut être vide),
  et, facultatifs, "remboursement" (Versement à la résiliation) et "renouvellement" (contrat qui le renouvelle).
  À inclure avec : <%@ include file="/WEB-INF/views/common/contrat-infos.jspf" %>
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<p>Client : <c:out value="${contrat.client.utilisateur.prenom} ${contrat.client.utilisateur.nom}"/>
  (<c:out value="${contrat.client.utilisateur.email}"/>)</p>
<p>Type d'assurance : <c:out value="${contrat.typeAssurance.nom}"/></p>
<p>Du <c:out value="${contrat.dateDebut}"/> au <c:out value="${contrat.dateFin}"/></p>
<p>Prime annuelle : <c:out value="${contrat.prime}"/> €</p>
<p>Statut : <c:out value="${contrat.statut}"/></p>
<c:if test="${contrat.statut == 'RESILIE'}">
  <p>Résilié le <c:out value="${contrat.dateResiliation}"/><c:if test="${not empty contrat.motifResiliation}"> :
    <c:out value="${contrat.motifResiliation}"/></c:if></p>
  <%-- Part de la prime payée qui n'était plus couverte (ContratService.remboursement) --%>
  <c:if test="${not empty remboursement}">
    <p>Remboursé de <c:out value="${remboursement.montant}"/> € le <c:out value="${remboursement.dateVersement}"/>
      (part de la prime correspondant à la période non couverte).</p>
  </c:if>
</c:if>
<%-- Suspension décidée par un agent : sans date, le contrat est suspendu faute de paiement --%>
<c:if test="${contrat.suspenduParAgent}">
  <p><strong>Suspendu par un agent depuis le <c:out value="${contrat.dateSuspension}"/></strong> :
    <c:out value="${contrat.motifSuspension}"/>.
    Pendant la suspension, le contrat ne couvre pas les sinistres.</p>
</c:if>
<c:if test="${contrat.statut == 'SUSPENDU' and not contrat.suspenduParAgent}">
  <p>Suspendu faute de paiement : il sera actif dès que la prime sera payée.</p>
</c:if>
<%-- Lien entre un contrat et son renouvellement, dans les deux sens --%>
<c:set var="espaceContrats" value="${sessionScope.utilisateur.role == 'CLIENT' ? 'client' : 'agent'}"/>
<c:if test="${not empty contrat.contratPrecedent}">
  <p>Renouvelle le contrat
    <a href="${pageContext.request.contextPath}/${espaceContrats}/contrats/detail?id=${contrat.contratPrecedent.id}">n° <c:out value="${contrat.contratPrecedent.id}"/></a>.</p>
</c:if>
<c:if test="${not empty renouvellement}">
  <p>Renouvelé par le contrat
    <a href="${pageContext.request.contextPath}/${espaceContrats}/contrats/detail?id=${renouvellement.id}">n° <c:out value="${renouvellement.id}"/></a>
    (du <c:out value="${renouvellement.dateDebut}"/> au <c:out value="${renouvellement.dateFin}"/>).</p>
</c:if>

<h2>Garanties</h2>
<table border="1">
  <thead>
    <tr>
      <th>Garantie</th>
      <th>Plafond</th>
      <th>Franchise</th>
    </tr>
  </thead>
  <tbody>
    <c:forEach var="g" items="${contrat.garanties}">
      <tr>
        <td><c:out value="${g.nom}"/></td>
        <td><c:out value="${g.plafond}"/> €</td>
        <td><c:out value="${g.franchise}"/> €</td>
      </tr>
    </c:forEach>
  </tbody>
</table>

<h2>Paiement</h2>
<c:choose>
  <c:when test="${empty paiement}">
    <p>Aucun paiement n'est associé à ce contrat.</p>
  </c:when>
  <c:otherwise>
    <p>Montant : <c:out value="${paiement.montant}"/> €, à régler au plus tard le <c:out value="${paiement.dateEcheance}"/></p>
    <p>Statut : <c:out value="${paiement.statut}"/></p>
    <c:if test="${paiement.statut == 'EFFECTUE'}">
      <p>Payé le <c:out value="${paiement.datePaiement}"/> par <c:out value="${paiement.modePaiement}"/></p>
    </c:if>
  </c:otherwise>
</c:choose>

<%@ page pageEncoding="UTF-8" %>
<%--
  Vérifie avant l'envoi la taille des fichiers choisis dans les formulaires de classe "form-pieces"
  (5 Mo par fichier, 25 Mo en tout, comme le @MultipartConfig des servlets).
  Sans ce contrôle, Tomcat coupe la connexion sur un fichier trop gros et le navigateur affiche une erreur
  au lieu du message. Le serveur vérifie de toute façon : ce n'est qu'un confort.
--%>
<script>
  document.querySelectorAll('.form-pieces').forEach(function (formulaire) {
    formulaire.addEventListener('submit', function (e) {
      var champ = formulaire.querySelector('input[type=file]');
      var total = 0;
      for (var i = 0; i < champ.files.length; i++) {
        total += champ.files[i].size;
        if (champ.files[i].size > 5 * 1024 * 1024) {
          alert('Le fichier « ' + champ.files[i].name + ' » dépasse 5 Mo.');
          e.preventDefault();
          return;
        }
      }
      if (total > 25 * 1024 * 1024) {
        alert('Les fichiers dépassent 25 Mo en tout : envoyez-les en plusieurs fois.');
        e.preventDefault();
      }
    });
  });
</script>

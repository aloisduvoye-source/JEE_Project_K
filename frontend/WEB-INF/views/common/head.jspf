<%@ page pageEncoding="UTF-8" %>
<%--
  Début commun de <head>, à inclure dans chaque page juste après <head> :
    <%@ include file="/WEB-INF/views/common/head.jspf" %>
  puis ajouter le <title> de la page.

  - charge la feuille de style et le script communs (assets/css/app.css, assets/js/app.js) ;
  - applique le thème clair ou sombre AVANT l'affichage (sinon la page clignote) :
    le choix fait avec le bouton de la barre, sinon celui du système ;
  - ajoute la classe "js" à <html> : le CSS n'affiche les éléments qui ont besoin de
    JavaScript (filtres, bouton de thème...) que si le script fonctionne.
--%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232f54eb'/%3E%3Cpath d='M16 6.5 8.5 9.3v5.6c0 4.8 3.2 8.4 7.5 9.6 4.3-1.2 7.5-4.8 7.5-9.6V9.3L16 6.5Z' fill='none' stroke='white' stroke-width='2.2' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css">
<script>
  (function () {
    var racine = document.documentElement;
    var theme = null;
    racine.classList.add('js');
    try { theme = localStorage.getItem('theme'); } catch (e) { /* stockage indisponible */ }
    if (theme !== 'dark' && theme !== 'light') {
      theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    racine.setAttribute('data-theme', theme);
  })();
</script>
<script src="${pageContext.request.contextPath}/assets/js/app.js" defer></script>

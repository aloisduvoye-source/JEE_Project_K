# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité)
DB_URL=jdbc:mysql://localhost:3306/assurance
DB_USER=
DB_PASSWORD=
# Clé Google Gemini : https://aistudio.google.com/apikey
AI_API_KEY=
# Facultatifs : modèle principal et modèle de secours (par défaut gemini-flash-lite-latest / gemini-flash-latest)
AI_MODEL=
AI_MODEL_SECOURS=
